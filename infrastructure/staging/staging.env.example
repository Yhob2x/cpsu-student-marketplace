# EXAMPLE ONLY. NEVER populate this template with real secret values or commit a populated copy.
# Staging is not the local test schema, the development DB, or the production DB.
NODE_ENV=production
PORT=4400
BIND_HOST=127.0.0.1
DATABASE_URL=mysql://__STAGING_DB_USER__:__STAGING_DB_PASSWORD__@127.0.0.1:3306/cpsu_marketplace_staging
JWT_SECRET=__STAGING_UNIQUE_JWT_SECRET_32_PLUS_CHARS__
CORS_ORIGINS=https://__STAGING_DOMAIN__
COOKIE_SECURE=true
UPLOAD_DIR=/var/lib/cpsu-marketplace-staging/uploads

# Provision a separate staging VAPID key pair securely, or reuse a development pair
# only after explicit approval; never publish or commit its private key.
# A real monitored contact replaces the localhost-only VAPID subject.
VAPID_PUBLIC_KEY=__STAGING_VAPID_PUBLIC_KEY__
VAPID_PRIVATE_KEY=__STAGING_VAPID_PRIVATE_KEY__
VAPID_SUBJECT=mailto:__APPROVED_MONITORED_CONTACT_EMAIL__
