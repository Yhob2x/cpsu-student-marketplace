generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  active
  suspended
}

enum VerificationStatus {
  unverified
  pending
  verified
  rejected
  suspended
}

enum Role {
  campus_reviewer
  university_admin
  system_admin
  establishment
}

enum SellerType {
  student
  establishment
}

enum ApprovalStatus {
  pending
  approved
  rejected
  suspended
}

enum ListingType {
  physical_product
  service
}

enum ListingStatus {
  draft
  pending_review
  changes_requested
  published
  rejected
  suspended
}

// C4 approved: item condition applies to products, not services.
// Legacy products remain nullable until their sellers supply a condition.
enum ListingCondition {
  new
  like_new
  good
  fair
}

enum AvailabilityState {
  available
  reserved
  sold
}

enum ReviewDecision {
  approved
  changes_requested
  rejected
}

enum PolicyAction {
  review
  prohibit
}

enum InquiryStatus {
  open
  closed
}

enum HandoffMethod {
  campus_pickup
  scheduled_meeting
  seller_delivery
  off_campus
  digital_delivery
  appointment
}

enum HandoffStatus {
  proposed
  agreed
  completed
  cancelled
  not_confirmed
}

// C5 approved: canonical mutually confirmed self-reported transactions.
enum TransactionStatus {
  pending
  accepted
  negotiating
  for_meetup
  completed
  cancelled
}

enum StoreReviewStatus {
  pending
  published
  rejected
  hidden
}

enum ReportStatus {
  open
  reviewing
  resolved
  dismissed
}

enum AnnouncementStatus {
  draft
  published
  archived
}

model GuidelineContent {
  id            Int       @id
  draftBody     String    @db.Text
  publishedBody String?   @db.Text
  updatedAt     DateTime  @updatedAt
  publishedAt   DateTime?
}

model HomePageContent {
  id                Int       @id
  draft             Json
  published         Json?
  revision          Int       @default(1)
  publishedRevision Int       @default(0)
  updatedAt         DateTime  @updatedAt
  publishedAt       DateTime?
}

model Announcement {
  id          Int                @id @default(autoincrement())
  title       String             @db.VarChar(120)
  body        String             @db.Text
  pendingTitle String?            @db.VarChar(120)
  pendingBody  String?            @db.Text
  status      AnnouncementStatus @default(draft)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  publishedAt DateTime?

  @@index([status, publishedAt])
}

model Campus {
  id     Int     @id @default(autoincrement())
  code   String  @unique
  name   String
  active Boolean @default(true)

  affiliations Affiliation[]
  listings     Listing[]
  campusRoles           UserRole[]
  campusPolicies        CampusPolicy[]
  restrictedCategories  RestrictedCategory[]
  sellerProfiles        SellerProfile[]

}

model Category {
  id              Int         @id @default(autoincrement())
  parentId        Int?
  name            String
  listingType     ListingType
  policyRiskLevel Int         @default(0)

  listings Listing[]
  parent               Category?            @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children             Category[]           @relation("CategoryHierarchy")
  restrictedCategories RestrictedCategory[]

}

model User {
  id           Int        @id @default(autoincrement())
  email        String     @unique
  displayName  String
  passwordHash String
  status       UserStatus @default(active)
  // Private student identity is never included in public profile selects.
  studentIdentity StudentIdentity?

  affiliations   Affiliation[]
  roles          UserRole[]
  sellerProfiles SellerProfile[]
  inquiryMessages InquiryMessage[]
  sessions              Session[]
  listingReviews        ListingReview[]      @relation("ListingReviewer")
  savedListings         SavedListing[]
  storeFollows          StoreFollow[]
  storeAppreciations    StoreAppreciation[]
  buyerThreads          InquiryThread[]
  reportedItems         Report[]             @relation("ReportReporter")
  assignedReports       Report[]             @relation("ReportAssignee")
  notifications         Notification[]
  pushSubscriptions     PushSubscription[]
  pushPreference        PushPreference?
  auditLogs             AuditLog[]
  buyingTransactions    Transaction[] @relation("TransactionBuyer")
  sellingTransactions   Transaction[] @relation("TransactionSeller")
  transactionEvents     TransactionStatusLog[] @relation("TransactionEventActor")
  authoredStoreReviews    StoreReview[] @relation("StoreReviewBuyer")

}

// Separate 1:1 private record. Collection remains off pending CPSU DPO approval.
// Do not add a global uniqueness rule for student numbers without CPSU policy.
model StudentIdentity {
  userId           Int      @id
  fullName         String   @db.VarChar(120)
  studentIdNumber  String   @db.VarChar(48)
  createdAt        DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
}

model Affiliation {
  id                 Int                 @id @default(autoincrement())
  userId             Int
  campusId           Int
  verificationStatus VerificationStatus   @default(pending)
  verifiedAt         DateTime?
  expirationAt       DateTime?

  user   User   @relation(fields: [userId], references: [id])
  campus Campus @relation(fields: [campusId], references: [id])

  @@unique([userId, campusId])
}

model UserRole {
  id       Int   @id @default(autoincrement())
  userId   Int
  role     Role
  campusId Int?

  user User @relation(fields: [userId], references: [id])
  campus Campus? @relation(fields: [campusId], references: [id], onDelete: Restrict, onUpdate: Cascade)

}

model Session {
  id               Int       @id @default(autoincrement())
  userId           Int
  refreshTokenHash String    @unique
  device           String    @default("")
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

}

model CampusPolicy {
  id            Int      @id @default(autoincrement())
  campusId      Int
  version       Int      @default(1)
  effectiveDate DateTime
  approvedBy    String
  documentRef   String

  restrictedCategories RestrictedCategory[]
  campus         Campus          @relation(fields: [campusId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  listingReviews ListingReview[]


  @@unique([campusId, version])
}

model RestrictedCategory {
  id              Int          @id @default(autoincrement())
  campusId        Int
  categoryId      Int
  policyAction    PolicyAction @default(review)
  policyVersionId Int?

  policy CampusPolicy? @relation(fields: [policyVersionId], references: [id])
  campus   Campus   @relation(fields: [campusId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Cascade)


  @@unique([campusId, categoryId])
}

model SellerProfile {
  id              Int            @id @default(autoincrement())
  ownerUserId     Int
  campusId        Int
  storeName       String
  description     String         @db.Text
  sellerType      SellerType     @default(student)
  approvalStatus  ApprovalStatus @default(pending)
  // Store-owner photos publish immediately after file validation and sanitization.
  avatarPath      String?        @db.VarChar(255)
  createdAt       DateTime       @default(now())

  owner          User            @relation(fields: [ownerUserId], references: [id])
  listings       Listing[]
  inquiryThreads InquiryThread[]
  storeFollows   StoreFollow[]
  storeAppreciations StoreAppreciation[]
  storeReviews   StoreReview[]
  campus  Campus   @relation(fields: [campusId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  reports Report[] @relation("ReportSeller")

}

// A student can follow a given store at most once. Public store connections
// expose active followers' display names only, never private account fields.
model StoreFollow {
  userId          Int
  sellerProfileId Int
  createdAt       DateTime @default(now())

  user  User          @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  store SellerProfile @relation(fields: [sellerProfileId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@id([userId, sellerProfileId])
  @@index([sellerProfileId, createdAt])
}

// Appreciation is a reversible, non-transactional thank-you, not a rating or CPSU endorsement.
model StoreAppreciation {
  userId          Int
  sellerProfileId Int
  createdAt       DateTime @default(now())

  user  User          @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  store SellerProfile @relation(fields: [sellerProfileId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@id([userId, sellerProfileId])
  @@index([sellerProfileId, createdAt])
}

model Listing {
  id             Int           @id @default(autoincrement())
  sellerProfileId Int
  campusId       Int
  categoryId     Int
  type           ListingType
  title          String
  description    String         @db.Text
  price          Decimal        @db.Decimal(10, 2)
  priceBasis     String         @default("per item")
  currency       String         @default("PHP")
  availability   String         @default("available") // Legacy compatibility; canonical field is availabilityState.
  availabilityState AvailabilityState @default(available)
  condition      ListingCondition?
  deletedAt      DateTime?
  reservationTransactionId Int? @unique
  handoffNote    String?        @db.VarChar(200)
  status         ListingStatus @default(draft)
  flags          Json?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  seller        SellerProfile   @relation(fields: [sellerProfileId], references: [id])
  campus        Campus          @relation(fields: [campusId], references: [id])
  category      Category        @relation(fields: [categoryId], references: [id])
  media         ListingMedia[]
  threads       InquiryThread[]
  savedListings SavedListing[]
  listingReviews ListingReview[]
  reports        Report[] @relation("ReportListing")
  transactions   Transaction[] @relation("TransactionListing")
  reservedBy     Transaction? @relation("TransactionReservation", fields: [reservationTransactionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  @@index([status, categoryId, campusId, createdAt], map: "Listing_discovery_idx")

}

model ListingMedia {
  id        Int    @id @default(autoincrement())
  listingId Int
  mediaPath String
  mimeType  String
  position  Int    @default(0)

  listing Listing @relation(fields: [listingId], references: [id])
}

// Student buyer ratings are attached to actual completed marketplace transactions.
// Moderation is mandatory before public publication.
model StoreReview {
  id               Int @id @default(autoincrement())
  transactionId    Int @unique
  sellerProfileId  Int
  buyerUserId      Int
  rating           Int
  body             String? @db.VarChar(800)
  status           StoreReviewStatus @default(pending)
  moderationReason String? @db.VarChar(500)
  moderatedAt      DateTime?
  createdAt        DateTime @default(now())

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  store       SellerProfile @relation(fields: [sellerProfileId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  buyer       User @relation("StoreReviewBuyer", fields: [buyerUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  @@index([sellerProfileId, status, createdAt])
  @@index([buyerUserId, createdAt])
}

model ListingReview {
  id              Int            @id @default(autoincrement())
  listingId       Int
  reviewerId      Int
  decision        ReviewDecision
  reason          String         @db.Text
  policyVersionId Int?
  createdAt       DateTime       @default(now())
  listing  Listing       @relation(fields: [listingId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  reviewer User          @relation("ListingReviewer", fields: [reviewerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  policy   CampusPolicy? @relation(fields: [policyVersionId], references: [id], onDelete: Restrict, onUpdate: Cascade)

}

model InquiryThread {
  id              Int           @id @default(autoincrement())
  listingId       Int
  buyerUserId     Int
  sellerProfileId Int
  status          InquiryStatus @default(open)
  createdAt       DateTime      @default(now())

  listing  Listing         @relation(fields: [listingId], references: [id])
  seller   SellerProfile   @relation(fields: [sellerProfileId], references: [id])
  messages InquiryMessage[]
  buyer   User     @relation(fields: [buyerUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  handoff Handoff?
  transactions Transaction[]


  @@unique([listingId, buyerUserId])
}

model InquiryMessage {
  id           Int      @id @default(autoincrement())
  threadId     Int
  authorUserId Int
  body         String   @db.Text
  deliveredAt  DateTime?
  seenAt       DateTime?
  createdAt    DateTime @default(now())

  thread InquiryThread @relation(fields: [threadId], references: [id])
  author User          @relation(fields: [authorUserId], references: [id])
}

model Handoff {
  id              Int           @id @default(autoincrement())
  inquiryThreadId Int           @unique
  method          HandoffMethod
  timeWindow      String
  generalLocation String
  status          HandoffStatus @default(proposed)
  createdAt       DateTime      @default(now())
  thread InquiryThread @relation(fields: [inquiryThreadId], references: [id], onDelete: Restrict, onUpdate: Cascade)

}

// TransactionStatusLog is append-only application history, not a claim of verified payment.
model Transaction {
  id                        Int      @id @default(autoincrement())
  inquiryThreadId           Int
  activeThreadId            Int?     @unique // NULL when terminal; permits repeat service requests.
  listingId                 Int
  buyerUserId               Int
  sellerUserId              Int
  status                    TransactionStatus @default(pending)
  price                     Decimal @db.Decimal(10, 2)
  currency                  String  @default("PHP") @db.VarChar(3)
  buyerMeetupConfirmedAt    DateTime?
  sellerMeetupConfirmedAt   DateTime?
  buyerCompletionConfirmedAt DateTime?
  sellerCompletionConfirmedAt DateTime?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  thread     InquiryThread @relation(fields: [inquiryThreadId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  listing    Listing @relation("TransactionListing", fields: [listingId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  buyer      User @relation("TransactionBuyer", fields: [buyerUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  seller     User @relation("TransactionSeller", fields: [sellerUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  reservation Listing? @relation("TransactionReservation")
  history    TransactionStatusLog[]
  storeReview StoreReview?

  @@index([buyerUserId, status, createdAt])
  @@index([sellerUserId, status, createdAt])
  @@index([listingId, status])
  @@index([inquiryThreadId, createdAt])
}

model TransactionStatusLog {
  id            Int @id @default(autoincrement())
  transactionId Int
  actorUserId   Int
  fromStatus    TransactionStatus?
  toStatus      TransactionStatus
  event         String @db.VarChar(40)
  reason        String? @db.VarChar(500)
  createdAt     DateTime @default(now())

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  actor       User @relation("TransactionEventActor", fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([transactionId, id])
}

model SavedListing {
  id        Int      @id @default(autoincrement())
  userId    Int
  listingId Int
  createdAt DateTime @default(now())

  listing Listing @relation(fields: [listingId], references: [id])
  user User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)


  @@unique([userId, listingId])
}

model Report {
  id                 Int          @id @default(autoincrement())
  reporterUserId     Int
  listingId          Int?
  sellerProfileId    Int?
  reason             String       @db.Text
  status             ReportStatus @default(open)
  assignedReviewerId Int?
  createdAt          DateTime     @default(now())
  reporter        User           @relation("ReportReporter", fields: [reporterUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  listing         Listing?       @relation("ReportListing", fields: [listingId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  seller          SellerProfile? @relation("ReportSeller", fields: [sellerProfileId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  assignedReviewer User?         @relation("ReportAssignee", fields: [assignedReviewerId], references: [id], onDelete: Restrict, onUpdate: Cascade)

}

model AuditLog {
  id          Int      @id @default(autoincrement())
  actorUserId Int?
  action      String
  targetType  String
  targetId   Int?
  metadata    Json?
  createdAt   DateTime @default(now())
  actor User? @relation(fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)

}

model Notification {
  id        Int       @id @default(autoincrement())
  userId    Int
  type      String
  payload   Json?
  readAt    DateTime?
  createdAt DateTime  @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

}

model PushSubscription {
  id           Int      @id @default(autoincrement())
  userId       Int
  endpointHash String   @unique @db.Char(64)
  endpoint     String   @db.Text
  p256dh       String   @db.VarChar(256)
  auth         String   @db.VarChar(128)
  expiresAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// Push delivery is opt-in by subscription. Event categories can be disabled independently.
// This table is not the source of in-app notification truth.
model PushPreference {
  userId         Int      @id
  messages       Boolean  @default(true)
  listingReviews Boolean  @default(true)
  accountUpdates Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
