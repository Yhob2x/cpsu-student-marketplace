DATABASE_URL="mysql://user:password@localhost:3306/cpsu_marketplace"
# Staging must set BIND_HOST=127.0.0.1 to keep Express behind Nginx.
# Existing dev installations use the default host until explicitly configured.
BIND_HOST="0.0.0.0"
JWT_SECRET="change-me-at-least-32-characters-long"
# Optional Web Push. Generate one persistent VAPID key pair using scripts/generate-vapid-keys.mjs.
# Never commit the private key or place it in client-side code.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT=""
# Release safety: enabling subscriptions alone never activates outbound delivery.
# Default OFF on all environments. Requires separate staging approvals.
PUSH_SUBSCRIPTIONS_ENABLED="false"
PUSH_DELIVERY_ENABLED="false"
