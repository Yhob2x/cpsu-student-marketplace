{
  "name": "cpsu-student-marketplace",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "setup": "cd laravel-project && composer install && bun install && cd photo-service && bun install",
    "serve": "cd laravel-project && php artisan serve",
    "web": "cd laravel-project && bun run dev",
    "photo": "cd laravel-project/photo-service && bun run start",
    "build": "cd laravel-project && bun run build",
    "db:migrate": "cd laravel-project && php artisan migrate",
    "db:seed": "cd laravel-project && php artisan db:seed",
    "test": "cd laravel-project && php artisan test",
    "test:frontend": "cd laravel-project && bun run test:frontend",
    "test:e2e": "cd laravel-project && bun run test:e2e",
    "pwa:check": "node scripts/validate-pwa.cjs"
  }
}
