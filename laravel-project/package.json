{
    "name":  "@cpsu/laravel-web",
    "private":  true,
    "version":  "1.0.0",
    "type":  "module",
    "scripts":  {
                    "setup":  "composer install && bun install && cd photo-service && bun install",
                    "serve":  "php artisan serve",
                    "photo":  "cd photo-service && bun run start",
                    "db:migrate":  "php artisan migrate",
                    "db:seed":  "php artisan db:seed",
                    "test":  "php artisan test",
                    "pwa:check":  "node scripts/validate-pwa.cjs",
                    "dev":  "vite",
                    "build":  "tsc --noEmit \u0026\u0026 vite build",
                    "typecheck":  "tsc --noEmit",
                    "test:frontend":  "bun test tests/frontend",
                    "test:e2e":  "playwright test",
                    "test:a11y":  "playwright test tests/e2e/accessibility.pw.ts tests/e2e/accessibility-states.pw.ts"
                },
    "dependencies":  {
                         "@maplibre/maplibre-gl-leaflet":  "0.1.4",
                         "@tailwindcss/vite":  "4.3.5",
                         "class-variance-authority":  "0.7.1",
                         "cn":  "0.5.2",
                         "leaflet":  "1.9.4",
                         "lucide-react":  "1.74.0",
                         "maplibre-gl":  "6.19.0",
                         "radix-ui":  "1.8.1",
                         "react":  "18.3.1",
                         "react-dom":  "18.3.1",
                         "react-router-dom":  "6.30.6",
                         "shadcn":  "4.23.0",
                         "tailwindcss":  "4.3.5",
                         "tw-animate-css":  "1.4.0"
                     },
    "devDependencies":  {
                            "@axe-core/playwright":  "4.14.0",
                            "@happy-dom/global-registrator":  "21.0.4",
                            "@playwright/test":  "1.65.1",
                            "@testing-library/jest-dom":  "7.0.1",
                            "@testing-library/react":  "16.3.3",
                            "@testing-library/user-event":  "14.6.12",
                            "@types/leaflet":  "1.9.22",
                            "@types/react":  "18.3.31",
                            "@types/react-dom":  "18.3.7",
                            "@vitejs/plugin-react":  "4.7.0",
                            "happy-dom":  "21.0.4",
                            "laravel-vite-plugin":  "^1.2.0",
                            "typescript":  "5.9.3",
                            "vite":  "6.4.6"
                        },
    "overrides":  {
                      "@maplibre/maplibre-gl-style-spec":  "26.8.0",
                      "@babel/runtime":  "7.29.14",
                      "rollup":  "4.68.2",
                      "postcss":  "8.5.32",
                      "csstype":  "3.2.3"
                  }
}
