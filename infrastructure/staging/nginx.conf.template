# STAGING TEMPLATE ONLY — NOT ACTIVATED. Do not copy to Nginx without approved DNS/TLS/deployment.
# Replace all __STAGING_*__ and certificate placeholders with approved values.
# Keep staging data/users fully separate from production and development.
server {
    listen 80;
    server_name __STAGING_DOMAIN__;

    # For trusted ACME issuance after domain ownership verification.
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
    }
    location / {
        return 301 https://$host$request_uri;
    }
}
server {
    listen 443 ssl http2;
    server_name __STAGING_DOMAIN__;

    ssl_certificate __STAGING_CERT_FULLCHAIN__;
    ssl_certificate_key __STAGING_CERT_PRIVKEY__;
    ssl_protocols TLSv1.2 TLSv1.3;

    # Staging is not indexed. Only enable HSTS after validating HTTPS.
    add_header X-Robots-Tag "noindex, nofollow, noarchive" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    client_max_body_size 4m;
    root __STAGING_WEB_ROOT__;
    index index.html;

    # Same-origin API. Credentials and authenticated responses must not be cached.
    location /api/ {
        proxy_pass http://127.0.0.1:4400;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 30s;
        add_header Cache-Control "no-store" always;
    }
    # Make installed PWAs pick up push-handler and icon updates.
    location = /sw.js {
        default_type application/javascript;
        add_header Cache-Control "no-cache" always;
        try_files $uri =404;
    }
    location = /manifest.webmanifest {
        default_type application/manifest+json;
        add_header Cache-Control "no-cache" always;
        try_files $uri =404;
    }
    location = /index.html {
        add_header Cache-Control "no-store" always;
        try_files $uri =404;
    }
    # Block hidden files should any ever be copied into the static directory.
    location ~ /\. {
        return 404;
    }

    # Content-hashed Vite build output only; never cache HTML or API responses.
    location ^~ /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }
    location = /offline.html {
        add_header Cache-Control "no-cache" always;
        try_files $uri =404;
    }

    # All app pages share the one React/Vite PWA; no server-side account-data caching.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
