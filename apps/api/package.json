{
  "name": "@cpsu/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build": "bunx prisma generate && bun build src/index.ts --outdir dist --target bun --external sharp --external argon2",
    "start": "bun dist/index.js",
    "db:migrate": "bunx prisma migrate dev",
    "db:deploy": "bunx prisma migrate deploy",
    "db:seed": "bun prisma/seed.ts",
    "test": "bun test",
    "test:integration": "bun test/run-integration.ts",
    "test:push:integration": "bun test/run-push-integration.ts",
    "db:integrity-preflight": "bun scripts/integrity-preflight.ts --audit-only",
    "db:restore-rehearsal": "bun scripts/verify-integrity-restore.ts --isolated-restore",
    "typecheck": "bunx prisma generate && bunx tsc -p . --noEmit"
  },
  "dependencies": {
    "@prisma/client": "6.1.0",
    "@tensorflow/tfjs": "^4.22.0",
    "argon2": "^0.41.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^5.0.1",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "2.5.0",
    "nsfwjs": "^4.4.0",
    "sharp": "0.35.5",
    "web-push": "^4.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "2.3.0",
    "@types/node": "^22.10.2",
    "@types/supertest": "^6.0.2",
    "@types/web-push": "^3.6.4",
    "prisma": "6.1.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
